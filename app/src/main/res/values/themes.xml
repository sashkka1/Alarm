<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ⚠️ windowBackground — это то, что видно, пока Compose не отрисовал первый
         кадр: при старте окна и при каждом его пересоздании. Белым он быть не может
         (владелец, 2026-08-25): любая заминка старта читалась как «приложение
         сломалось, остался белый экран». Цвет — фон самого приложения, поэтому
         заминки не видно вовсе. -->
    <style name="Theme.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Экран тревоги: без анимации появления — он должен возникать мгновенно, а не выезжать.
         Фон до первого кадра — тема по умолчанию; выбранную тему окну ставит код (paintWindow)
         первой строкой, до содержимого. Сигнально-красного экрана больше нет: экран тревоги
         живёт в теме настроек (владелец, 2026-10-14). -->
    <style name="Theme.Alarm.FullScreen" parent="Theme.Alarm">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
